        }
        

        private void ClockTimer_Tick(object sender, EventArgs e)
        {
            lblTime.Text = DateTime.Now.ToString("HH:mm:ss");
        }
        
        
        private void PlayTestSound(string file)
        {
            if (!File.Exists(file))
            {
                MessageBox.Show("音频文件不存在：" + file);
                return;
            }

            Task.Run(() =>
            {
                try
                {
                    using var audio = new NAudio.Wave.AudioFileReader(file);
                    using var output = new NAudio.Wave.WaveOutEvent
                    {
                        DeviceNumber = comboDevice.SelectedIndex
                    };

                    output.Init(audio);
                    output.Play();

                    while (output.PlaybackState == NAudio.Wave.PlaybackState.Playing)
                        Thread.Sleep(100);
                }
                catch (Exception ex)
                {
                    MessageBox.Show("播放失败：" + ex.Message);
                }
            });
        }


        private void btnTestEndBell_Click(object sender, EventArgs e)
        {
            PlayTestSound(txtEndBell.Text);
        }

        private void btnTestStartBell_Click(object sender, EventArgs e)
        {
            PlayTestSound(txtStartBell.Text);
        }
