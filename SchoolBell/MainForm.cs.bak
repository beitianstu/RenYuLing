        public MainForm()
        {
            InitializeComponent();
            LoadAudioDevices();
            scheduler = new BellScheduler(this);


            // 绑定事件
            btnStart.Click += btnStart_Click;
            btnStop.Click += btnStop_Click;
            btnChooseStartBell.Click += btnChooseStartBell_Click;
            btnChooseEndBell.Click += btnChooseEndBell_Click;
            scheduler.LoadJsonSchedule(Path.Combine(AppContext.BaseDirectory, "schedule.json"));
            clockTimer = new System.Windows.Forms.Timer();
            clockTimer.Interval = 500; // 每秒刷新
            clockTimer.Tick += ClockTimer_Tick;
            clockTimer.Start();
            btnTestStartBell.Click += btnTestStartBell_Click;
            btnTestEndBell.Click += btnTestEndBell_Click;
            countdownTimer = new System.Windows.Forms.Timer();
            countdownTimer.Interval = 500; // 每秒刷新
            countdownTimer.Start();
            // UpdateNextBell();
            showClasses.Text += ShowClasses_Text;
            string status = scheduler.LoadJsonSchedule(Path.Combine(AppContext.BaseDirectory, "schedule.json"));
            lblScheduleStatus.Text = "课表状态：" + status;
            UpdateScheduleDisplay();
            UpdateRunStatus("NOT RUNNING");
            scheduler.SetNextClassLabels(lblNextBell, lblCountdown);
            scheduler.MicStatusChanged += OnMicStatusChanged;
            schedule = LoadSchedule("schedule.json");   // 读取 JSON

            

        }
        
        
        
        [DllImport("user32.dll")]
        static extern void keybd_event(byte bVk, byte bScan, int dwFlags, int dwExtraInfo);

        const int KEYEVENTF_KEYUP = 0x0002;

        private void ToggleMic()
        {
            // Alt down
            keybd_event(0x12, 0, 0, 0);

            // M down
            keybd_event(0x4D, 0, 0, 0);

            // M up
            keybd_event(0x4D, 0, KEYEVENTF_KEYUP, 0);

            // Alt up
            keybd_event(0x12, 0, KEYEVENTF_KEYUP, 0);
        }
        


        private void Check()
        {
            UpdateNextBellUI(); // UI 刷新
            scheduler.CheckBell(); // 铃声检查
        }

        private DateTime? GetNextBellTime()
        {
            DateTime now = DateTime.Now;

            var next = schedule
                .Where(c => DateTime.Today.Add(c.Start) >= now)
                .OrderBy(c => c.Start)
                .FirstOrDefault();

            if (next == null)
                return null;

            return DateTime.Today.Add(next.Start);
        }





        private void LoadAudioDevices()
        {
            for (int i = 0; i < WaveOut.DeviceCount; i++)
            {
                var caps = WaveOut.GetCapabilities(i);
                comboDevice.Items.Add(caps.ProductName);
            }
        }
        

        private void btnStart_Click(object sender, EventArgs e)
        {
            scheduler.SetDevice(comboDevice.SelectedIndex);
            scheduler.SetAudio(txtStartBell.Text, txtEndBell.Text);
            scheduler.SetSchedule(schedule);
            scheduler.Start();
            // scheduler.PlayBell("start.wav",3);
            // scheduler.PlayBell(txtStartBell.Text,3);
            MessageBox.Show("已启动");
            UpdateRunStatus("RUNNING");
        }

        private void btnStop_Click(object sender, EventArgs e)
        {
            scheduler.Stop();
            // scheduler.PlayBell(txtEndBell.Text,1);
            MessageBox.Show("已停止");
            UpdateRunStatus("STOPPED");
        }

        private void btnChooseStartBell_Click(object sender, EventArgs e)
        {
            var dlg = new OpenFileDialog();
            dlg.Filter = "音频文件|*.wav;*.mp3";
            if (dlg.ShowDialog() == DialogResult.OK)
                txtStartBell.Text = dlg.FileName;
        }

        private void btnChooseEndBell_Click(object sender, EventArgs e)
        {
            var dlg = new OpenFileDialog();
            dlg.Filter = "音频文件|*.wav;*.mp3";
            if (dlg.ShowDialog() == DialogResult.OK)
                txtEndBell.Text = dlg.FileName;
        }
        

        private void MainForm_Load(object sender, EventArgs e)
