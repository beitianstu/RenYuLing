        private void UpdateScheduleDisplay()
        {
            if (scheduler.schedule == null || scheduler.schedule.Count == 0)
            {
                showClasses.Text = "课表为空";
                return;
            }

            var sb = new System.Text.StringBuilder();
            sb.AppendLine("今日课表：");

            foreach (var item in scheduler.schedule)
            {
                if (item.Start != TimeSpan.Zero)
                    sb.AppendLine($"{item.Start:hh\\:mm} 上课");

                if (item.End != TimeSpan.Zero)
                    sb.AppendLine($"{item.End:hh\\:mm} 下课");
            }

            showClasses.Text = sb.ToString();
        }


