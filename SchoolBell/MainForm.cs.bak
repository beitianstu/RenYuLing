        }
        
        private void UpdateRunStatus(string status)
        {
            lblRunStatus.Text = "运行状态：" + status;

            if (status == "RUNNING")
            {
                lblRunStatus.ForeColor = Color.Green;
            }
            else
            {
                lblRunStatus.ForeColor = Color.Red;
            }
        }


