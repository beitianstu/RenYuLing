        private ScheduleItem GetNextClass()
        {
            DateTime now = DateTime.Now;

            return schedule
                .Where(c => DateTime.Today.Add(c.Start) >= now)
                .OrderBy(c => c.Start)
                .FirstOrDefault();
        }
        private void UpdateNextBellUI()
        {
            DateTime now = DateTime.Now;
            DateTime? nextBell = GetNextBellTime();

            if (nextBell == null)
            {
                lblNextBell.Text = "今天课程已结束";
                lblCountdown.Text = "";
                return;
            }

            TimeSpan remain = nextBell.Value - now;
            // Console.wl
            lblNextBell.Text = $"下一次铃声：{nextBell.Value:HH:mm}";
            lblCountdown.Text = $"倒计时：{remain.Hours:D2}:{remain.Minutes:D2}:{remain.Seconds:D2}";
        }
        
        private List<ScheduleItem> LoadSchedule(string jsonPath)
        {
            string json = File.ReadAllText(jsonPath);
            return JsonConvert.DeserializeObject<List<ScheduleItem>>(json);
        }

