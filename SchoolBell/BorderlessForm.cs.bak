using System.Drawing.Drawing2D;
using System.Runtime.InteropServices;
using Timer = System.Windows.Forms.Timer;

namespace SchoolBell;

// 无边框毛玻璃模式：显示课表与下一次铃声倒计时（Fluent 设计风格）
public class BorderlessForm : Form
{
    // Fluent 配色
    private static readonly Color Accent = Color.FromArgb(0, 120, 215);        // Windows 主题蓝
    private static readonly Color TextPrimary = Color.FromArgb(250, 250, 250);
    private static readonly Color TextSecondary = Color.FromArgb(200, 200, 200);
    private static readonly Color TextTertiary = Color.FromArgb(140, 140, 140);
    private static readonly Color CardFill = Color.FromArgb(46, 46, 46);       // Acrylic 卡片
    private static readonly Color CardStroke = Color.FromArgb(66, 66, 66);

    private static readonly Font FontTitle = new("Segoe UI Variable Display", 13F, FontStyle.Bold);
    // 课表列表用 Microsoft YaHei UI：数字列对齐更好（原字体）
    private static readonly Font FontBody = new("Microsoft YaHei UI", 10F);
    private static readonly Font FontCaption = new("Segoe UI Variable Text", 8F);
    private static readonly Font FontCountdown = new("Segoe UI Variable Display", 26F, FontStyle.Bold);
    private static readonly Font FontNext = new("Segoe UI Variable Text", 10.5F);

    private const int Space = 16;    // Fluent 4px 栅格
    private const int Gap = 12;
    private const int Radius = 8;    // Fluent 圆角

    private readonly BellScheduler scheduler;
    private readonly Timer refreshTimer;
    private readonly Label lblCountdown;
    private readonly Label lblNextBell;
    private readonly Label lblTitle;
    private readonly Label lblHint;
    private readonly Button btnTopMost;
    private readonly Panel cardSchedule;
    private readonly ListBox lstSchedule;
    private readonly Panel cardCountdown;
    private string lastScheduleSnapshot = "";
    private int lastSelectedIndex = -2;

    // ===== 自适应透明度 =====
    // 背后窗口很亮（可读性低）时提高不透明度，暗时保持通透，带缓动动画
    private const int AlphaMin = 0x70;   // 最通透（下限提高）
    private const int AlphaMax = 0xE0;   // 最不透明（上限提高，更接近实底）
    private const double LumaLow = 90;   // 低于此亮度不再加深
    private const double LumaHigh = 170; // 高于此亮度视为完全不可读
    private const double LumaHysteresis = 12; // 亮度回差，防止边界附近来回切换
    private readonly Timer opacityTimer;
    private int currentAlpha = AlphaMin;
    private int targetAlpha = AlphaMin;
    private double lastSampledLuma = -1;

    // 彻底清除边框相关窗口样式，否则 DWM 会在边缘画出黑色残影条
    protected override CreateParams CreateParams
    {
        get
        {
            var cp = base.CreateParams;
            const int WS_BORDER = 0x00800000;
            const int WS_DLGFRAME = 0x00400000;
            const int WS_THICKFRAME = 0x00040000;
            const int WS_CAPTION = WS_BORDER | WS_DLGFRAME;
            cp.Style &= ~(WS_CAPTION | WS_THICKFRAME);
            return cp;
        }
    }

    public BorderlessForm(BellScheduler scheduler)
    {
        this.scheduler = scheduler;

        FormBorderStyle = FormBorderStyle.None;
        StartPosition = FormStartPosition.CenterScreen;
        Size = new Size(380, 480);
        BackColor = Color.FromArgb(24, 24, 24);
        DoubleBuffered = true;
        ShowInTaskbar = true;
        ShowIcon = false;
        Text = "任禹铃 · 课表";
        TopMost = true;

        // 标题
        lblTitle = new Label
        {
            Location = new Point(Space, Space),
            Size = new Size(220, 28),
            ForeColor = TextPrimary,
            Font = FontTitle,
            Text = "今日课表",
            BackColor = Color.Transparent
        };

        // 置顶按钮（Fluent 幽灵按钮风格）
        btnTopMost = new Button
        {
            Location = new Point(380 - Space - 96, Space),
            Size = new Size(96, 30),
            FlatStyle = FlatStyle.Flat,
            ForeColor = TextSecondary,
            BackColor = CardFill,
            Font = FontCaption,
            Cursor = Cursors.Hand,
            TabStop = false
        };
        btnTopMost.FlatAppearance.BorderColor = CardStroke;
        btnTopMost.FlatAppearance.MouseOverBackColor = Color.FromArgb(56, 56, 56);
        btnTopMost.FlatAppearance.MouseDownBackColor = Color.FromArgb(40, 40, 40);
        btnTopMost.Click += (_, _) =>
        {
            TopMost = !TopMost;
            UpdateTopMostButton();
        };
        UpdateTopMostButton();

        // 课表卡片（圆角面板 + 列表）
        cardSchedule = new RoundedPanel
        {
            Location = new Point(Space, 56),
            Size = new Size(380 - Space * 2, 250),
            BackColor = CardFill
        };

        // 内缩避开圆角区域，否则直角的列表会盖住圆角处的背景色
        lstSchedule = new ListBox
        {
            Location = new Point(Radius, Radius),
            Size = new Size(cardSchedule.Width - Radius * 2, cardSchedule.Height - Radius * 2),
            BorderStyle = BorderStyle.None,
            BackColor = CardFill,
            ForeColor = TextPrimary,
            Font = FontBody,
            ItemHeight = 26,
            TabStop = false,
            IntegralHeight = false
        };
        cardSchedule.Controls.Add(lstSchedule);

        // 倒计时卡片
        cardCountdown = new RoundedPanel
        {
            Location = new Point(Space, 56 + 250 + Gap),
            Size = new Size(380 - Space * 2, 110),
            BackColor = CardFill
        };

        lblNextBell = new Label
        {
            Location = new Point(Space, 14),
            Size = new Size(cardCountdown.Width - Space * 2, 24),
            ForeColor = TextSecondary,
            Font = FontNext,
            BackColor = Color.Transparent
        };

        lblCountdown = new Label
        {
            Location = new Point(Space, 42),
            Size = new Size(cardCountdown.Width - Space * 2, 56),
            ForeColor = Accent,
            Font = FontCountdown,
            BackColor = Color.Transparent
        };
        cardCountdown.Controls.Add(lblNextBell);
        cardCountdown.Controls.Add(lblCountdown);

        // 底部提示
        lblHint = new Label
        {
            Location = new Point(Space, 480 - Space - 18),
            Size = new Size(380 - Space * 2, 18),
            ForeColor = TextTertiary,
            Font = FontCaption,
            Text = "双击或右键返回主界面 · 拖动移动",
            BackColor = Color.Transparent
        };

        Controls.Add(lblTitle);
        Controls.Add(cardSchedule);
        Controls.Add(cardCountdown);
        Controls.Add(lblHint);
        Controls.Add(btnTopMost);
        btnTopMost.BringToFront();

        // 拖动：窗体与不可交互区域
        MouseDown += DragMove;
        lblTitle.MouseDown += DragMove;
        lblHint.MouseDown += DragMove;
        cardSchedule.MouseDown += DragMove;
        cardCountdown.MouseDown += DragMove;
        lblNextBell.MouseDown += DragMove;
        lblCountdown.MouseDown += DragMove;

        refreshTimer = new Timer { Interval = 500 };
        refreshTimer.Tick += (_, _) => RefreshDisplay();
        refreshTimer.Start();

        // 自适应透明度：采样 + 缓动动画
        // 30fps——颜色键采样后不再需要低频，更新更跟手
        opacityTimer = new Timer { Interval = 33 };
        opacityTimer.Tick += OpacityTimer_Tick;
        opacityTimer.Start();

        RefreshDisplay();
    }

    private int opacitySampleCounter;

    private void OpacityTimer_Tick(object? sender, EventArgs e)
    {
        // 拖动窗口时不采样：否则采样会把窗口瞬移出屏幕，和拖动冲突导致位置回跳
        var isDragging = (Control.MouseButtons & MouseButtons.Left) == MouseButtons.Left;

        // 每 ~0.5 秒采样一次背后窗口亮度，决定目标透明度
        if (!isDragging)
        {
            opacitySampleCounter++;
            if (opacitySampleCounter >= 15)
            {
                opacitySampleCounter = 0;
                targetAlpha = ComputeTargetAlpha();
            }
        }

        // 缓动逼近目标值（指数平滑，动画流畅且不会过冲）
        if (currentAlpha == targetAlpha) return;

        var delta = targetAlpha - currentAlpha;
        var step = Math.Max(1, Math.Abs(delta) / 20) * Math.Sign(delta);
        currentAlpha = Math.Abs(targetAlpha - currentAlpha) <= Math.Abs(step)
            ? targetAlpha
            : currentAlpha + step;

        ApplyAlpha(currentAlpha);
    }

    // 采样背后窗口的真实亮度：先隐藏自身再取色，避免读到自己的半透明叠加色
    private int ComputeTargetAlpha()
    {
        try
        {
            var luma = SampleBehindLuma();
            if (luma < 0) return targetAlpha;

            // 回差：亮度相对上次采样变化太小就不调整，避免边界附近来回切换
            if (lastSampledLuma >= 0 && Math.Abs(luma - lastSampledLuma) < LumaHysteresis)
                return targetAlpha;
            lastSampledLuma = luma;

            // 亮度 [LumaLow, LumaHigh] 映射到 alpha [AlphaMin, AlphaMax]
            var t = Math.Clamp((luma - LumaLow) / (LumaHigh - LumaLow), 0.0, 1.0);
            return (int)(AlphaMin + t * (AlphaMax - AlphaMin));
        }
        catch
        {
            return targetAlpha;
        }
    }

    // 采样点（窗口内 5 个五等分点，水平和垂直方向各取中线的 1/6..5/6）
    // 这些点上各画 1 个颜色键像素，颜色键完全透明，因此 DWM 在这些像素处不合成，
    // 直接抓屏就能读到背后真实像素——窗口无需移动，也就没有任何闪烁。
    private static readonly Point[] SamplePoints =
    {
        new(1, 1), new(3, 1), new(5, 1),
        new(1, 3), new(3, 3), new(5, 3),
        new(1, 5), new(3, 5), new(5, 5)
    };

    // 颜色键：纯品红，界面中不会出现的颜色，被设为完全透明
    private const uint ColorKey = 0x00FF00FF; // 0x00BBGGRR

    // 采样各采样点正后方的像素亮度求平均，失败返回 -1
    private double SampleBehindLuma()
    {
        var screen = GetDC(IntPtr.Zero);
        try
        {
            double total = 0;
            var count = 0;

            foreach (var p in SamplePoints)
            {
                // 五等分点：x = Width * p.X / 6, y = Height * p.Y / 6
                var x = Left + Width * p.X / 6;
                var y = Top + Height * p.Y / 6;
                var pixel = GetPixel(screen, x, y);
                if (pixel == -1) continue;

                var r = pixel & 0xFF;
                var g = (pixel >> 8) & 0xFF;
                var b = (pixel >> 16) & 0xFF;
                total += 0.299 * r + 0.587 * g + 0.114 * b;
                count++;
            }

            return count > 0 ? total / count : -1;
        }
        finally
        {
            ReleaseDC(IntPtr.Zero, screen);
        }
    }

    // 把窗口设为分层窗口并应用颜色键：颜色键像素完全透明
    private void EnableColorKey()
    {
        // 加 WS_EX_LAYERED 样式
        var exStyle = GetWindowLong(Handle, GWL_EXSTYLE);
        SetWindowLong(Handle, GWL_EXSTYLE, exStyle | WS_EX_LAYERED);

        // 颜色键透明（LWA_COLORKEY），其他像素不受影响
        SetLayeredWindowAttributes(Handle, ColorKey, 0, LWA_COLORKEY);
    }

    private const int GWL_EXSTYLE = -20;
    private const int WS_EX_LAYERED = 0x00080000;
    private const uint LWA_COLORKEY = 0x00000001;

    [DllImport("user32.dll")]
    private static extern int GetWindowLong(IntPtr hWnd, int nIndex);

    [DllImport("user32.dll")]
    private static extern int SetWindowLong(IntPtr hWnd, int nIndex, int dwNewLong);

    [DllImport("user32.dll")]
    private static extern bool SetLayeredWindowAttributes(IntPtr hwnd, uint crKey, byte bAlpha, uint dwFlags);

    // 重新设置亚克力，只改 alpha，颜色保持深灰
    private void ApplyAlpha(int alpha)
    {
        var accent = new AccentPolicy
        {
            AccentState = AccentState.ACCENT_ENABLE_ACRYLICBLURBEHIND,
            AccentFlags = 0x20,
            GradientColor = unchecked((int)((uint)(alpha << 24) | 0x00141414)),
            AnimationId = 1 // 让 DWM 对属性变化做过渡，减轻跳变
        };

        var accentSize = Marshal.SizeOf(accent);
        var accentPtr = Marshal.AllocHGlobal(accentSize);
        Marshal.StructureToPtr(accent, accentPtr, false);

        var data = new WindowCompositionAttributeData
        {
            Attribute = WindowCompositionAttribute.WCA_ACCENT_POLICY,
            SizeOfData = accentSize,
            Data = accentPtr
        };

        SetWindowCompositionAttribute(Handle, ref data);
        Marshal.FreeHGlobal(accentPtr);
    }

    private void UpdateTopMostButton()
    {
        btnTopMost.Text = TopMost ? "📌 已置顶" : "置顶";
    }

    protected override void OnHandleCreated(EventArgs e)
    {
        base.OnHandleCreated(e);
        EnableAcrylic();
        EnableColorKey();
    }

    // 在采样点画 1 像素颜色键，形成永久采样孔
    protected override void OnPaint(PaintEventArgs e)
    {
        base.OnPaint(e);
        using var brush = new SolidBrush(Color.Magenta); // 与 ColorKey 同色
        foreach (var p in SamplePoints)
        {
            var x = Width * p.X / 6;
            var y = Height * p.Y / 6;
            e.Graphics.FillRectangle(brush, x, y, 1, 1);
        }
    }

    protected override void OnFormClosed(FormClosedEventArgs e)
    {
        refreshTimer.Stop();
        refreshTimer.Dispose();
        opacityTimer.Stop();
        opacityTimer.Dispose();
        base.OnFormClosed(e);
    }

    private void RefreshDisplay()
    {
        var s = scheduler.schedule;
        if (s == null || s.Count == 0)
        {
            lstSchedule.Items.Clear();
            lstSchedule.Items.Add("课表为空");
            lblNextBell.Text = "";
            lblCountdown.Text = "";
            return;
        }

        var now = DateTime.Now;
        var next = s
            .Where(c => DateTime.Today.Add(c.Time) >= now)
            .OrderBy(c => c.Time)
            .FirstOrDefault();

        // 列表：高亮即将到来的项
        // 只在内容变化时重建，避免每 500ms 清空重绘造成闪烁
        var selectedIndex = -1;
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < s.Count; i++)
        {
            var item = s[i];
            var t = item.Type switch
            {
                "start" => "上课",
                "end" => "下课",
                _ => "默认"
            };
            var passed = DateTime.Today.Add(item.Time) < now;
            sb.AppendLine($"{item.Time:hh\\:mm}    {t}{(passed ? "  ·  已过" : "")}");

            if (selectedIndex < 0 && next != null && item.Time == next.Time && item.Type == next.Type)
                selectedIndex = i;
        }

        var snapshot = sb.ToString();
        if (snapshot != lastScheduleSnapshot)
        {
            lastScheduleSnapshot = snapshot;
            lstSchedule.BeginUpdate();
            lstSchedule.Items.Clear();
            foreach (var line in snapshot.Split(Environment.NewLine, StringSplitOptions.RemoveEmptyEntries))
                lstSchedule.Items.Add(line);
            lstSchedule.EndUpdate();
        }

        if (selectedIndex != lastSelectedIndex)
        {
            lastSelectedIndex = selectedIndex;
            if (selectedIndex >= 0)
                lstSchedule.SelectedIndex = selectedIndex;
            else
                lstSchedule.ClearSelected();
        }

        if (next == null)
        {
            lblNextBell.Text = "今天课程已结束";
            lblCountdown.Text = "—";
            return;
        }

        var nextTime = DateTime.Today.Add(next.Time);
        var remain = nextTime - now;
        var typeName = next.Type == "start" ? "上课" : "下课";

        lblNextBell.Text = $"距离{typeName} · {nextTime:HH:mm}";
        lblCountdown.Text = $"{remain.Hours:D2}:{remain.Minutes:D2}:{remain.Seconds:D2}";
    }

    // 无边框窗体交互：双击/右键返回主界面，左键按住拖动
    // 注意：不能依赖 DoubleClick 事件——WM_NCLBUTTONDOWN 会让系统抢走第二次点击
    private void DragMove(object? sender, MouseEventArgs e)
    {
        if (e.Button == MouseButtons.Right)
        {
            Close();
            return;
        }

        if (e.Button != MouseButtons.Left) return;

        if (e.Clicks >= 2)
        {
            Close();
            return;
        }

        ReleaseCapture();
        SendMessage(Handle, WM_NCLBUTTONDOWN, HTCAPTION, 0);
    }

    // Win10/11 亚克力毛玻璃：ACCENT_ENABLE_ACRYLICBLURBEHIND
    private void EnableAcrylic()
    {
        var accent = new AccentPolicy
        {
            AccentState = AccentState.ACCENT_ENABLE_ACRYLICBLURBEHIND,
            AccentFlags = 0x20,
            // ABGR：半透明深灰（alpha 越低越透明）
            GradientColor = unchecked((int)0x91),
            AnimationId = 0
        };

        var accentSize = Marshal.SizeOf(accent);
        var accentPtr = Marshal.AllocHGlobal(accentSize);
        Marshal.StructureToPtr(accent, accentPtr, false);

        var data = new WindowCompositionAttributeData
        {
            Attribute = WindowCompositionAttribute.WCA_ACCENT_POLICY,
            SizeOfData = accentSize,
            Data = accentPtr
        };

        SetWindowCompositionAttribute(Handle, ref data);
        Marshal.FreeHGlobal(accentPtr);
    }

    private const int WM_NCLBUTTONDOWN = 0xA1;
    private const int HTCAPTION = 0x2;

    [DllImport("user32.dll")]
    private static extern bool ReleaseCapture();

    [DllImport("user32.dll")]
    private static extern IntPtr SendMessage(IntPtr hWnd, int msg, int wParam, int lParam);

    [DllImport("user32.dll")]
    private static extern int SetWindowCompositionAttribute(IntPtr hwnd, ref WindowCompositionAttributeData data);

    [DllImport("user32.dll")]
    private static extern IntPtr GetDC(IntPtr hWnd);

    [DllImport("user32.dll")]
    private static extern int ReleaseDC(IntPtr hWnd, IntPtr hDC);

    [DllImport("gdi32.dll")]
    private static extern int GetPixel(IntPtr hdc, int x, int y);

    private enum AccentState
    {
        ACCENT_DISABLED = 0,
        ACCENT_ENABLE_GRADIENT = 1,
        ACCENT_ENABLE_TRANSPARENTGRADIENT = 2,
        ACCENT_ENABLE_BLURBEHIND = 3,
        ACCENT_ENABLE_ACRYLICBLURBEHIND = 4
    }

    [StructLayout(LayoutKind.Sequential)]
    private struct AccentPolicy
    {
        public AccentState AccentState;
        public int AccentFlags;
        public int GradientColor;
        public int AnimationId;
    }

    private enum WindowCompositionAttribute
    {
        WCA_ACCENT_POLICY = 19
    }

    [StructLayout(LayoutKind.Sequential)]
    private struct WindowCompositionAttributeData
    {
        public WindowCompositionAttribute Attribute;
        public IntPtr Data;
        public int SizeOfData;
    }

    // Fluent 圆角卡片：自定义 Region 裁剪 + 描边
    private sealed class RoundedPanel : Panel
    {
        public RoundedPanel()
        {
            DoubleBuffered = true;
            Padding = new Padding(0);
        }

        protected override void OnHandleCreated(EventArgs e)
        {
            base.OnHandleCreated(e);
            UpdateRegion();
        }

        protected override void OnResize(EventArgs e)
        {
            base.OnResize(e);
            UpdateRegion();
        }

        private void UpdateRegion()
        {
            if (Width <= 0 || Height <= 0) return;
            using var path = CreateRoundPath(new Rectangle(0, 0, Width, Height), Radius * 2);
            Region?.Dispose();
            Region = new Region(path);
        }

        protected override void OnPaint(PaintEventArgs e)
        {
            base.OnPaint(e);
            e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
            using var path = CreateRoundPath(new Rectangle(0, 0, Width - 1, Height - 1), Radius * 2);
            using var pen = new Pen(CardStroke, 1f);
            e.Graphics.DrawPath(pen, path);
        }

        private static GraphicsPath CreateRoundPath(Rectangle rect, int diameter)
        {
            var path = new GraphicsPath();
            path.AddArc(rect.X, rect.Y, diameter, diameter, 180, 90);
            path.AddArc(rect.Right - diameter, rect.Y, diameter, diameter, 270, 90);
            path.AddArc(rect.Right - diameter, rect.Bottom - diameter, diameter, diameter, 0, 90);
            path.AddArc(rect.X, rect.Bottom - diameter, diameter, diameter, 90, 90);
            path.CloseFigure();
            return path;
        }
    }
}
