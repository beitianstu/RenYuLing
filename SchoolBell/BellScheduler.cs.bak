        public static async Task PlayBell(string filePath, int repeatTimes, int deviceNumber = -1)
        {
            if (!File.Exists(filePath))
                throw new FileNotFoundException("找不到指定的音频文件", filePath);
 
            for (int i = 0; i < repeatTimes; i++)
            {
                await PlayOnceAsync(filePath, deviceNumber);
            }
        }
 
        private static Task PlayOnceAsync(string filePath, int deviceNumber)
        {
            var tcs = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
 
            var audioFile = new AudioFileReader(filePath);
            var output = new WaveOut { DeviceNumber = deviceNumber };
 
            output.Init(audioFile);
            output.PlaybackStopped += (s, e) =>
            {
                output.Dispose();
                audioFile.Dispose();
                tcs.TrySetResult(true);
            };
            output.Play();
 
            return tcs.Task;
        }
  
        private static async Task PlayBellSafely()
        {
            try
            {
                await BellScheduler.PlayBell("bell.wav", 3);
            }
            catch (Exception ex)
            {
                // 异步方法里抛的异常不会自动冒泡，务必自己 catch，否则会被吞掉
                Console.WriteLine($"播放失败: {ex.Message}");
            }
        }

