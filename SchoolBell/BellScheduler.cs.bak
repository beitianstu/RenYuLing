        public void PauseBell()
        {
            if (player != null && isPlaying && !isPaused)
            {
                player.Pause();
                isPaused = true;
                remainTimer.Stop();
                MessageBox.Show("此功能暂时无法使用");
            }
        }

        public void  ResumeBell()
        {
            if (player != null && isPlaying && isPaused)
            {
                isPaused = false;
                remainTimer.Start();
                MessageBox.Show("此功能暂时无法使用");
            }
        }



        public string LoadJsonSchedule(string jsonPath)
        {
            if (!File.Exists(jsonPath))
                return $"未找到课表文件：{jsonPath}";

            try
            {
                var json = File.ReadAllText(jsonPath);
                var entries = JsonSerializer.Deserialize<List<ScheduleEntry>>(json);

                if (entries == null || entries.Count == 0)
                    return "课表为空";

                schedule = new List<ScheduleItem>();

                foreach (var e in entries)
                {
                    if (!TimeSpan.TryParse(e.time, out var ts))
                        return $"时间格式错误：{e.time}";

                    schedule.Add(new ScheduleItem
                    {
                        Name = e.type,
                        Start = e.type == "start" ? ts : TimeSpan.Zero,
                        End = e.type == "end" ? ts : TimeSpan.Zero
                    });
                }
                Console.WriteLine(schedule + schedule.Count.ToString());
                return $"已加载（{schedule.Count} 条）";
            }
            catch (Exception ex)
            {
                return $"加载失败：" + ex.Message;
            }
        }


        public BellScheduler(Label remainLabel)
        {
            lblRemainTime = remainLabel;

            remainTimer = new System.Windows.Forms.Timer();
            remainTimer.Interval = 200; // 每 0.2 秒更新一次
            remainTimer.Tick += RemainTimer_Tick;
        }
        


        public BellScheduler(List<ScheduleItem> schedule)
        {
            this.schedule = schedule;
        }

        
        public event Action<bool> MicStatusChanged;



        private void RemainTimer_Tick(object sender, EventArgs e)
        {
            if (audioReader == null || player == null) return;
            if (!isPlaying) return;

            currentPositionMs = audioReader.CurrentTime.TotalMilliseconds;

            double remainMs = totalDurationMs - currentPositionMs;

            if (remainMs < 0) remainMs = 0;

            TimeSpan remain = TimeSpan.FromMilliseconds(remainMs);

            lblRemainTime.Text = $"剩余时间：{remain.Minutes:D2}:{remain.Seconds:D2}";
        }

        
    }
    
