        private System.Windows.Forms.Timer schedulerTimer;

        private Label lblRemainTime;                      // 用于显示剩余时间的 Label

        [DllImport("user32.dll")]
        static extern void keybd_event(byte bVk, byte bScan, int dwFlags, int dwExtraInfo);

        const int KEYEVENTF_KEYUP = 0x0002;

        private bool micMuted = false;

        public void ToggleMic()
        {
            micMuted = !micMuted;

            // Alt+M
            keybd_event((byte)Keys.Menu, 0, 0, 0);
            keybd_event((byte)Keys.M, 0, 0, 0);
            keybd_event((byte)Keys.M, 0, 2, 0);
            keybd_event((byte)Keys.Menu, 0, 2, 0);

            // 通知 MainForm
            MicStatusChanged?.Invoke(micMuted);
        }

        public List<ScheduleItem> schedule;
        private Timer timer;
        private int deviceIndex;
        private string startBell;
        private string endBell;
        private Dictionary<string, DateTime> triggered = new Dictionary<string, DateTime>();
        private WaveOutEvent player;
        private AudioFileReader audioReader;
        private bool isPlaying = false;
        private bool isPaused = false;

        public void SetDevice(int index) => deviceIndex = index;
        public void SetAudio(string start, string end)
        {
            startBell = start;
            endBell = end;
        }

        public void SetSchedule(List<ScheduleItem> s) => schedule = s;



        public void Start()
        {
            schedulerTimer = new System.Windows.Forms.Timer();
            schedulerTimer.Interval = 1000; // 每秒检查一次
            schedulerTimer.Tick += SchedulerTimer_Tick;
            schedulerTimer.Start();
        }

        public void Stop()
        {
            timer?.Dispose();
        }

        
        private Form form;

        public BellScheduler(Form mainForm)
        {
            form = mainForm;
        }
        
        private void SchedulerTimer_Tick(object sender, EventArgs e)
        {
            CheckBell();
        }
        private Label lblNextClass;
        private Label lblCountdown;

        public void SetNextClassLabels(Label nextClassLabel, Label countdownLabel)
        {
            lblNextClass = nextClassLabel;
            lblCountdown = countdownLabel;
        }

        private void UpdateNextClassCountdown(DateTime now)
        {
            if (schedule == null || schedule.Count == 0)
            {
                lblNextClass.Text = "无课表";
                lblCountdown.Text = "";
                return;
            }
        
            // 找到下一节课（必须用 >= 而不是 >）
            var next = schedule
                .Where(c => DateTime.Today.Add(c.Start) >= now)
                .OrderBy(c => c.Start)
                .FirstOrDefault();
        
            // 如果今天的课都结束了，显示明天第一节课
            if (next == null)
            {
                lblNextClass.Text = "今天课程已结束";
                lblCountdown.Text = "";
                return;
            }
        
            DateTime nextStart = DateTime.Today.Add(next.Start);
            TimeSpan remain = nextStart - now;
        
            lblNextClass.Text = $"下一节课：{next.Start}";
            lblCountdown.Text = $"倒计时：{remain.Hours:D2}:{remain.Minutes:D2}:{remain.Seconds:D2}";
        }

        

        public void CheckBell()
        {
            Console.WriteLine("Now CheckBell Thread:" + Thread.CurrentThread.ManagedThreadId);
            
            DateTime now = DateTime.Now;
            Console.WriteLine("CheckBell is Running. Now time is:" + now.ToString("HH:mm:ss"));

            foreach (var c in schedule)
            {
                DateTime startTime = DateTime.Today.Add(c.Start);
                DateTime endTime = DateTime.Today.Add(c.End);

                // 上课铃
                if (now >= startTime && now < startTime.AddSeconds(1))
                {
                    Console.WriteLine("CONDITIONS MET! Playing startBell.");
                    PlayBell(startBell, 3,deviceIndex);
                }

                // 下课铃
                if (now >= endTime && now < endTime.AddSeconds(1))
                {
                    Console.WriteLine("CONDITIONS MET! Playing endBell.");
                    PlayBell(endBell, 1,deviceIndex);
                }
            }
        }

